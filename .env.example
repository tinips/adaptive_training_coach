# Core runtime
ENVIRONMENT=development
LOG_LEVEL=INFO
DEFAULT_BOT_LANGUAGE=en
TELEGRAM_BOT_TOKEN=
DATABASE_URL=postgresql+asyncpg://coach:coach@localhost:55432/adaptive_coach
PUBLIC_BASE_URL=http://localhost:8000

# Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
APP_ENCRYPTION_KEY=

# LLM-backed explicit free-text paths
LLM_MODE=mock
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=gpt-4.1-mini
LLM_MIN_CONFIDENCE=0.75
LLM_OTHER_REQUESTS_PER_HOUR=10
AI_WORKFLOW_NAME=onboarding_text_parser

# Strava
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REDIRECT_URI=http://localhost:8000/integrations/strava/callback
STRAVA_INITIAL_SYNC_DAYS=56
STRAVA_SYNC_PAGE_SIZE=100
STRAVA_SYNC_COOLDOWN_SECONDS=300
STRAVA_WEBHOOK_VERIFY_TOKEN=
STRAVA_WEBHOOK_SUBSCRIPTION_ID=
OAUTH_STATE_TTL_SECONDS=600
