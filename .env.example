# Copy to .env and replace every CHANGEME value. Defaults keep LLM/Langfuse off.
ENVIRONMENT=development
LOG_LEVEL=INFO
DEFAULT_BOT_LANGUAGE=en
DATABASE_URL=postgresql+asyncpg://coach:coach@localhost:55432/adaptive_coach
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEB_APP_URL=
TELEGRAM_ALLOWED_USER_IDS=
DEV_TELEGRAM_USER_IDS=
LLM_MODE=mock
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
LLM_MIN_CONFIDENCE=0.75
LLM_OTHER_REQUESTS_PER_HOUR=10
LLM_VISION_MODEL=deepseek-v4-flash-vision-exp
SCREENSHOT_IMPORT_ENABLED=false
APPLE_HEALTH_IMPORT_ENABLED=true
APPLE_HEALTH_IMPORT_MAX_COMPRESSED_SIZE_MB=100
APPLE_HEALTH_IMPORT_MAX_UNCOMPRESSED_SIZE_MB=1024
APPLE_HEALTH_IMPORT_MAX_ZIP_MEMBERS=100
APPLE_HEALTH_IMPORT_MAX_COMPRESSION_RATIO=200
APPLE_HEALTH_IMPORT_TEMP_DIR=
APPLE_HEALTH_IMPORT_KEEP_ORIGINAL_FILES=false
TCX_IMPORT_ENABLED=true
TCX_IMPORT_MAX_SIZE_MB=25
FITNESS_WINDOW_DAYS=14
PLANNER_WINDOW_DAYS=30

# Optional, metadata-only self-hosted Langfuse tracing (disabled by default).
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://langfuse-web:3000
LANGFUSE_NEXTAUTH_URL=http://localhost:3000
LANGFUSE_NEXTAUTH_SECRET=CHANGEME_generate_a_long_random_secret
LANGFUSE_SALT=CHANGEME_generate_a_long_random_secret
LANGFUSE_ENCRYPTION_KEY=CHANGEME_64_hex_characters_openssl_rand_hex_32
LANGFUSE_POSTGRES_PASSWORD=CHANGEME
LANGFUSE_CLICKHOUSE_PASSWORD=CHANGEME
LANGFUSE_REDIS_PASSWORD=CHANGEME
LANGFUSE_MINIO_PASSWORD=CHANGEME
